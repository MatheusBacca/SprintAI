# SprintAI — configuração local (NÃO coloque tokens do Jira/Bitbucket/OpenAI aqui:
# eles ficam no Cofre do Windows e são cadastrados pela tela Configurações › Conexões).

# Postgres local (docker-compose)
DB_HOST=127.0.0.1
DB_PORT=5433
DB_NAME=sprintai
DB_USER=sprintai
DB_PASSWORD=sprintai

# API local — só escuta em loopback
API_HOST=127.0.0.1
API_PORT=8765

# Origem do front em desenvolvimento (Vite)
FRONT_ORIGIN=http://localhost:5273
